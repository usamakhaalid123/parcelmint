{
  "name": "cod-commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cash-on-delivery e-commerce platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usamakhaalid123/parcelmint.git"
  },
  "bugs": {
    "url": "https://github.com/usamakhaalid123/parcelmint/issues"
  },
  "homepage": "https://github.com/usamakhaalid123/parcelmint#readme",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:provision-owner": "tsx src/db/provision-owner.ts",
    "db:seed": "tsx src/db/seed.ts",
    "validate": "prettier --check . && eslint . --max-warnings=0 && tsc --noEmit && vitest run tests/unit && vitest run tests/integration --passWithNoTests && next build --webpack"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
