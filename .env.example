# Runtime mode. Use "production" only with production resources.
DEPLOYMENT_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Phase 1: database, authentication, and storage
# Use the pooler URL at runtime and the direct database URL for controlled migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# This is Supabase's intentionally public client key, never the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_PRODUCTS=

# Generate a random value with at least 32 characters. Used only by scheduled worker calls.
WORKER_INVOCATION_SECRET=

# Later phases: external providers
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
COURIER_PROVIDER_API_KEY=
COURIER_WEBHOOK_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ID=
